@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()
LAYOUT_LEFT_RIGHT()

title C4 Container Diagram — AdScale (TO-BE)

' ====================== Акторы ======================
Person(advertiser, "Рекламодатель", "Управляет кампаниями, бюджетами и ставками через личный кабинет")
Person_Ext(endUser, "Пользователь сайта/приложения", "Просматривает рекламу, кликает по баннерам")

System_Ext(dspPartner, "DSP-партнёр", "Отправляет bid requests, получает bid responses по OpenRTB")
System_Ext(paymentGateway, "Платёжный шлюз", "Обработка пополнения рекламных бюджетов")
Container_Ext(kafka, "Apache Kafka", "Kafka 3.x", "Отправка событий (клики, показы, ставки)")
Container_Ext(apiGateway, "API Gateway", "Kong / Nginx", "Routing, rate limiting, circuit breaker")

' ====================== Микросервисы ======================

Container(adServer, "Ad Server", "Go", "Принимает HTTP-запросы, определяет пользователя, подбирает кандидатов в рекламу") 

Container(auctionEngine, "Auction Engine", "Go", "Взвешивание ставок, бизнес-правила, расчёт победителя аукциона") 

Container(deliveryService, "Delivery Service", "Node.js", "Формирует HTML/JS-разметку баннера и HTTP response")

Container(bidsCache, "Redis Cache", "Redis 7", "Кэш ставок и кампаний)")


Container(financialService, "Financial Service", "Go", "Списание средств, выставление счетов, управление балансами")

Container(analyticsService, "Analytics Service", "Python", "Аналитические SQL-запросы по production-БД") 

Container(adCabinet, "Advertiser Dashboard", "Node.js + JavaScript", "Web UI: управление кампаниями, отчётность")

Container(statsService, "Statistics Service", "Python", "Запись кликов и показов") 

' ====================== База данных ======================
ContainerDb(postgres, "PostgreSQL", "PostgreSQL (read-реплики)", "Кампании, ставки") 
ContainerDb(finPG, "PostgreSQL", "PostgreSQL (шарды, read-реплики)", "Балансы, транзакции") 
ContainerDb(clickHouse, "ClickHouse", "События, аналитика") 

' ====================== Связи ======================

Rel_U(dspPartner, apiGateway, "HTTPS / OpenRTB", "Bid requests / responses")
Rel_U(endUser, apiGateway, "HTTPS", "Просмотр рекламы и клики")
Rel_U(advertiser, apiGateway, "HTTPS", "Управляет кампаниями и бюджетами")
Rel(apiGateway, adServer, "Bid requests / responses", "Internal Call")
Rel(adServer, auctionEngine, "Передаёт кандидатов", "Internal Call")
Rel(adEngineOrchestator, deliveryService, "Передаёт победителя аукциона", "Internal Call")
Rel(apiGateway, adCabinet, "Управляет кампаниями и бюджетами", "HTTPS")
Rel(adCabinet, paymentGateway, "Пополнение бюджета", "HTTPS / REST")
Rel(adCabinet, financialService, "Управление финансами", "Internal Call")
Rel(adCabinet, analyticsService, "Запросы аналитики", "Internal Call")

' Связи с БД
Rel(auctionEngine, postgres, "Читает ставки и кампании", "JDBC / Sync")
Rel(auctionEngine, bidsCache, "Читает ставки и кампании", "JDBC / Sync")

Rel(adEngineOrchestator, kafka, "Пушит показы/клики", "Producer")
Rel(kafka, statsService, "Регистрирует показы/клики", "Consumer")
Rel(statsService, clickHouse, "Прямая запись событий", "JDBC / Direct Write")
Rel(financialService, finPG, "Балансы, транзакции", "JDBC")
Rel(analyticsService, clickHouse, "Тяжёлые аналитические запросы", "JDBC")
Rel(adCabinet, clickHouse, "Чтение событий", "JDBC")
Rel(adCabinet, postgres, "Управление ставками и кампаниями")
Rel(adServer, postgres, "Чтение данных для таргетинга", "JDBC")

' Принудительное расположение (layout hints)
' Lay_D(adServer, auctionEngine)
' Lay_D(auctionEngine, deliveryService)
' Lay_D(deliveryService, statsService)
' Lay_R(statsService, financialService)
' Lay_R(financialService, analyticsService)
' Lay_D(adCabinet, postgres)

' ' ====================== Аннотации проблемных мест ======================

' note right of auctionEngine
'   **⚠ Критический bottleneck**
'   Синхронные вызовы к БД
'   в hot path (SLA ≤ 100 ms)
' end note

' note right of postgres
'   **⚠ Single Point of Failure**
'   Одна инстанция — нет HA
'   Нет read-replicas
'   OLTP + аналитика конкурируют
' end note

' note bottom of statsService
'   **⚠ Write bottleneck**
'   Прямая запись без буферизации / очередей
'   Конкуренция за ресурсы БД
' end note

' note bottom of analyticsService
'   **⚠ Блокировки и рост latency**
'   Heavy queries напрямую на production-БД
' end note

' ' ====================== Легенда с метриками ======================
' legend right
'   <#FF0000> **15 000 RPS (пик)** 
'   <#FF7700> **P95 latency: 110–120 ms** (требование ≤ 100 ms)
'   <#FF7700> Периодические деградации в часы пик
'   <#FF0000> Нет запаса по производительности
'   <#888888> Деплой: вручную, без контейнеризации
'   <#888888> Кэширование: отсутствует
'   <#888888> Асинхронные очереди: отсутствуют
' endlegend
@enduml